{
  "homepage": "https://www.goldendreamsfsv.com",
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron.js",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "cors": "^2.8.6",
    "emailjs-com": "^3.2.0",
    "express": "^5.2.1",
    "framer-motion": "^12.23.25",
    "jspdf": "^4.2.1",
    "playwright": "^1.63.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-iframe": "^2.0.1",
    "react-pageflip": "^2.0.3",
    "react-router-dom": "^6.30.2",
    "react-scripts": "5.0.1",
    "react-swipeable": "^7.0.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node -e \"require('fs').copyFileSync('build/index.html','build/404.html')\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "build": {
    "extends": null,
    "appId": "com.goldendreamsfsv.desktop",
    "productName": "Golden Dreams",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "package.json",
      "assets/electron-icon.ico"
    ],
    "win": {
      "icon": "assets/electron-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/electron-icon.ico",
      "uninstallerIcon": "assets/electron-icon.ico",
      "installerHeaderIcon": "assets/electron-icon.ico"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "gh-pages": "^6.3.0",
    "png-to-ico": "^3.0.2"
  }
}
